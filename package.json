{
  "name": "roomlight",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Roomlight \u2014 a non-destructive, GPU-accelerated photo editor for the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:gpu": "node scripts/verify-gpu.mjs",
    "verify:e2e": "node scripts/e2e.mjs && node scripts/e2e-phase567.mjs",
    "build:single": "npm run build && node scripts/build-single.mjs",
    "verify:build": "npm run build:single && node scripts/smoke-build.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
